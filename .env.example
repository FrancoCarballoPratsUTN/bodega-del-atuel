# Copiar a .env y completar con valores propios. No commitear .env.
# Generar cada contraseña, por ejemplo: openssl rand -base64 24
POSTGRES_PASSWORD=
BDA_OWNER_PASSWORD=
BDA_DATABASE_PASSWORD=
BDA_REPORTES_PASSWORD=

# Orígenes permitidos por CORS (separados por coma).
BDA_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Puertos publicados en el host.
POSTGRES_PORT=5433
API_PORT=8000
FRONT_PORT=8080