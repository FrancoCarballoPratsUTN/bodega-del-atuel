        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: { &#39;primaryColor&#39;: &#39;#ffffff&#39;, &#39;primaryBorderColor&#39;: &#39;#000000&#39;, &#39;lineColor&#39;: &#39;#000000&#39;, &#39;textColor&#39;: &#39;#000000&#39;, &#39;fontFamily&#39;: &#39;monospace&#39;}}}%%\nerDiagram\n\n    LOCALIDAD {\n        PK cp \&quot;INT\&quot;\n        ATTR nombre \&quot;VARCHAR\&quot;\n        ATTR provincia \&quot;VARCHAR\&quot;\n        ATTR encargado_regional \&quot;VARCHAR\&quot;\n    }\n\n    SALA_VENTA {\n        PK id_sala \&quot;INT\&quot;\n        FK cp_localidad \&quot;INT\&quot;\n        ATTR calle \&quot;VARCHAR\&quot;\n        ATTR numero \&quot;INT\&quot;\n        ATTR dia_cierre \&quot;VARCHAR\&quot;\n    }\n\n    EMPLEADO {\n        PK cuit \&quot;CUIT_DOM\&quot;\n        FK id_sala \&quot;INT\&quot;\n        ATTR nombre \&quot;VARCHAR\&quot;\n        ATTR fecha_ingreso \&quot;DATE\&quot;\n        ATTR salario \&quot;NUMERIC\&quot;\n    }\n\n    TRANSPORTISTA {\n        PK cod_transportista \&quot;INT\&quot;\n        ATTR razon_social \&quot;VARCHAR\&quot;\n        ATTR cuit \&quot;CUIT_DOM\&quot;\n        ATTR email \&quot;VARCHAR\&quot;\n        ATTR telefono \&quot;VARCHAR\&quot;\n        ATTR domicilio \&quot;VARCHAR\&quot;\n    }\n\n    FINCA {\n        PK id_finca \&quot;INT\&quot;\n        ATTR nombre \&quot;VARCHAR\&quot;\n        ATTR superficie \&quot;NUMERIC\&quot;\n        ATTR departamento \&quot;VARCHAR\&quot;\n        ATTR provincia \&quot;VARCHAR\&quot;\n    }\n\n    CEPA {\n        PK id_cepa \&quot;INT\&quot;\n        ATTR nombre \&quot;VARCHAR\&quot;\n        ATTR tipo \&quot;VARCHAR\&quot;\n    }\n\n    PARCELA {\n        PK_FK id_finca \&quot;INT\&quot;\n        PK nro_parcela \&quot;INT\&quot;\n        FK id_cepa \&quot;INT\&quot;\n        ATTR superficie \&quot;NUMERIC\&quot;\n        ATTR anio_plantacion \&quot;INT\&quot;\n    }\n\n    BODEGA {\n        PK cuit_bodega \&quot;CUIT_DOM\&quot;\n        ATTR razon_social \&quot;VARCHAR\&quot;\n        ATTR domicilio \&quot;VARCHAR\&quot;\n    }\n\n    LOTE_UVA {\n        PK nro_lote \&quot;INT\&quot;\n        FK id_finca \&quot;INT\&quot;\n        FK nro_parcela \&quot;INT\&quot;\n        FK cuit_bodega \&quot;CUIT_DOM\&quot;\n        ATTR campania \&quot;INT\&quot;\n        ATTR fecha \&quot;DATE\&quot;\n        ATTR kg \&quot;NUMERIC\&quot;\n    }\n\n    ANALISIS_CALIDAD {\n        PK id_analisis \&quot;INT\&quot;\n        FK nro_lote \&quot;INT\&quot;\n        ATTR fecha \&quot;DATE\&quot;\n        ATTR brix \&quot;NUMERIC\&quot;\n        ATTR ph \&quot;NUMERIC\&quot;\n        ATTR acidez \&quot;NUMERIC\&quot;\n    }\n\n    VINO {\n        PK cod_vino \&quot;INT\&quot;\n        FK cuit_bodega \&quot;CUIT_DOM\&quot;\n        ATTR nombre \&quot;VARCHAR\&quot;\n        ATTR tipo \&quot;VARCHAR\&quot;\n        ATTR anada \&quot;INT\&quot;\n        ATTR volumen \&quot;NUMERIC\&quot;\n        ATTR graduacion \&quot;NUMERIC\&quot;\n        ATTR precio \&quot;NUMERIC\&quot;\n    }\n\n    MARIDAJE {\n        PK id_maridaje \&quot;INT\&quot;\n        ATTR nombre \&quot;VARCHAR\&quot;\n        ATTR temp_servicio \&quot;INT\&quot;\n    }\n\n    COMPOSICION {\n        PK_FK cod_vino \&quot;INT\&quot;\n        PK_FK id_cepa \&quot;INT\&quot;\n        ATTR porcentaje \&quot;NUMERIC\&quot;\n    }\n\n    VINO_MARIDAJE {\n        PK_FK cod_vino \&quot;INT\&quot;\n        PK_FK id_maridaje \&quot;INT\&quot;\n    }\n\n    TRANSPORTISTA_CUBRE_LOCALIDAD {\n        PK_FK cod_transportista \&quot;INT\&quot;\n        PK_FK cp_localidad \&quot;INT\&quot;\n    }\n\n    CLIENTE {\n        PK id_cliente \&quot;INT\&quot;\n        FK cp_localidad \&quot;INT\&quot;\n        ATTR nombre_razon_social \&quot;VARCHAR\&quot;\n        ATTR tipo_doc \&quot;VARCHAR\&quot;\n        ATTR nro_doc \&quot;VARCHAR\&quot;\n        ATTR direccion \&quot;VARCHAR\&quot;\n        ATTR fecha_alta \&quot;DATE\&quot;\n        ATTR descuento \&quot;NUMERIC\&quot;\n        ATTR tipo_cliente \&quot;VARCHAR\&quot;\n    }\n\n    DISTRIBUIDOR {\n        PK_FK id_cliente \&quot;INT\&quot;\n        ATTR zona_cobertura \&quot;VARCHAR\&quot;\n        ATTR nro_habilitacion \&quot;VARCHAR\&quot;\n    }\n\n    EXPORTADOR {\n        PK_FK id_cliente \&quot;INT\&quot;\n        ATTR pais_destino \&quot;VARCHAR\&quot;\n    }\n\n    PERMISO_EXPORTACION {\n        PK cod_permiso \&quot;INT\&quot;\n        FK id_cliente \&quot;INT\&quot;\n        ATTR fecha_emision \&quot;DATE\&quot;\n        ATTR fecha_vencimiento \&quot;DATE\&quot;\n    }\n\n    COMPROBANTE {\n        PK nro_comprobante \&quot;INT\&quot;\n        FK id_cliente \&quot;INT\&quot;\n        FK id_sala \&quot;INT\&quot;\n        ATTR fecha \&quot;TIMESTAMP\&quot;\n        ATTR subtotal \&quot;NUMERIC\&quot;\n        ATTR descuento \&quot;NUMERIC\&quot;\n        ATTR total \&quot;NUMERIC\&quot;\n    }\n\n    RENGLON_COMPROBANTE {\n        PK_FK nro_comprobante \&quot;INT\&quot;\n        PK_FK cod_vino \&quot;INT\&quot;\n        ATTR cantidad \&quot;INT\&quot;\n        ATTR precio_unitario \&quot;NUMERIC\&quot;\n        ATTR descuento \&quot;NUMERIC\&quot;\n        ATTR subtotal \&quot;NUMERIC\&quot;\n    }\n\n    INGRESO {\n        PK cod_ingreso \&quot;INT\&quot;\n        FK cod_transportista \&quot;INT\&quot;\n        FK cuit_bodega \&quot;CUIT_DOM\&quot;\n        ATTR fecha \&quot;TIMESTAMP\&quot;\n        ATTR estado \&quot;ESTADO_ENUM\&quot;\n    }\n\n    RENGLON_INGRESO {\n        PK_FK cod_ingreso \&quot;INT\&quot;\n        PK_FK cod_vino \&quot;INT\&quot;\n        ATTR cantidad \&quot;INT\&quot;\n    }\n\n    TRANSFERENCIA {\n        PK nro_transferencia \&quot;INT\&quot;\n        FK id_sala \&quot;INT\&quot;\n        ATTR fecha_confeccion \&quot;DATE\&quot;\n        ATTR estado \&quot;ESTADO_ENUM\&quot;\n    }\n\n    RENGLON_TRANSFERENCIA {\n        PK_FK nro_transferencia \&quot;INT\&quot;\n        PK_FK cod_vino \&qu