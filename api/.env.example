# prefer en local (sin TLS); require en producción (Supabase/Render).
BDA_DATABASE_SSLMODE=prefer
BDA_DATABASE_POOL_MIN_SIZE=1
BDA_DATABASE_POOL_MAX_SIZE=10
BDA_CORS_ORIGINS=http://localhost:8080,http://localhost:5173