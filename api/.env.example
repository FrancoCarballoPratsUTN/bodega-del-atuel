BDA_DATABASE_HOST=localhost
BDA_DATABASE_PORT=5432
BDA_DATABASE_NAME=bodega_del_atuel
BDA_DATABASE_USER=rol_api_lectura_escritura
# Sin default: completar en api/.env o en el entorno del proveedor.
